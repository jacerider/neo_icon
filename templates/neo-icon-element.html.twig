{#
/**
 * @file neo-icon-element.html.twig
 * Default theme implementation to present an icon along with its label.
 *
 * @see template_preprocess_neo_icon_element()
 *
 * @ingroup themeable
 */
#}
{%
  set classes = [
    'neo-icon-label',
    icon_only and icon ? 'sr-only',
  ]
%}
{% if icon and position=="before" %}
  {{ icon }}
{% endif %}
{% if title %}
  {% if icon_only and icon %}
    {# Fix for sr-only when in table. Causes page overflow. #}
    <span class="relative">
  {% endif %}
  <span {{ attributes.addClass(classes) }}>
    {{ title }}
  </span>
  {% if icon_only and icon %}
    </span>
  {% endif %}
{% endif %}
{% if icon and position=="after" %}
  {{ icon }}
{% endif %}
