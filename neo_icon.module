<?php

/**
 * @file
 * The module's four icon façades.
 *
 * Nothing in this file is a hook implementation. Every one of them is a method
 * on a class under `src/Hook` — \Drupal\neo_icon\Hook\NeoIconHooks for the
 * behavioural hooks, \Drupal\neo_icon\Hook\NeoIconThemeHooks for theme
 * registration, the four initial preprocess callbacks and the four preprocess
 * implementations, and \Drupal\neo_icon\Hook\NeoIconFormHooks for the form
 * alter and the entity builder it registers.
 *
 * What is left is four globals that are deliberately global. Their signatures
 * are frozen: roughly forty call sites in other packages, every file taking
 * this module's icon trait and every Twig `icon()` call reach this module
 * through them. Three of them construct an icon element and nothing else, so
 * there is nothing behind them to extract; the fourth delegates to
 * \Drupal\neo_icon\IconElementFactory, which is where its body went, and
 * carries a docblock-only `@deprecated` naming it — no runtime trigger, because
 * every rendered icon passes this way.
 *
 * The module declares `neo_icon.skip_procedural_hook_scan` so that core's hook
 * collector stops reading this file looking for hooks. That is not cosmetic:
 * the collector matches a procedural implementation by the shape
 * `{module}_{hook}`, and three of the four names below match it. Extension
 * loading is unaffected by the parameter — the module handler includes this
 * file regardless — which is what keeps all four defined.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\neo_icon\IconElement;

/**
 * Creates a new IconElement object.
 *
 * @param string|null $text
 *   The text to display with the icon.
 * @param string|null $icon
 *   The icon to display.
 * @param string|null $library
 *   The library to use for the icon.
 * @param array $prefix
 *   The prefix to use for the icon.
 *
 * @return \Drupal\neo_icon\IconElement
 *   The IconElement object.
 */
// phpcs:ignore Drupal.NamingConventions.ValidFunctionName.InvalidPrefix
function neo_icon($text = NULL, $icon = NULL, $library = NULL, array $prefix = []): IconElement {
  return new IconElement($text, $icon, $library, $prefix);
}

/**
 * Creates a new IconElement object.
 *
 * @param string|null $text
 *   The text to display with the icon.
 * @param string|null $icon
 *   The icon to display.
 *
 * @return \Drupal\neo_icon\IconElement
 *   The IconElement object.
 */
function neo_icon_admin($text = NULL, $icon = NULL): IconElement {
  return new IconElement($text, $icon, NULL, ['admin']);
}

// The deprecation sniff wants the @see below to be a drupal.org change record.
// This package is not on drupal.org, so the tag names the replacement instead.
// phpcs:disable Drupal.Commenting.Deprecated.DeprecatedWrongSeeUrlFormat

/**
 * Generates an IconElement for a given entity.
 *
 * Determines the appropriate label for the entity, using the bundle label if
 * available, and creates an IconElement instance with the label and entity type
 * information.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity for which to generate the icon element.
 * @param string $labelOverride
 *   An optional label override. If provided, this will be used as the label
 *   for the icon element instead of the entity label.
 *
 * @return \Drupal\neo_icon\IconElement
 *   The generated IconElement for the entity.
 *
 * @deprecated in neo_icon:1.2.0 and is removed from neo_icon:2.0.0. Use
 *   \Drupal\neo_icon\IconElementFactory::build() instead.
 *
 * @see \Drupal\neo_icon\IconElementFactory::build()
 */
function neo_icon_entity(EntityInterface $entity, ?string $labelOverride = NULL): IconElement {
  return \Drupal::service('neo_icon.element_factory')->build($entity, $labelOverride);
}

// phpcs:enable Drupal.Commenting.Deprecated.DeprecatedWrongSeeUrlFormat

/**
 * Generates an IconElement for a given entity type.
 *
 * Determines the appropriate label for the entity type and creates an
 * IconElement instance with the label and entity type information.
 *
 * @param \Drupal\Core\Entity\EntityTypeInterface $entity_type
 *   The entity type for which to generate the icon element.
 * @param string $labelOverride
 *   An optional label override. If provided, this will be used as the label
 *   for the icon element instead of the entity type label.
 *
 * @return \Drupal\neo_icon\IconElement
 *   The generated IconElement for the entity type.
 */
function neo_icon_entity_type(EntityTypeInterface $entity_type, ?string $labelOverride = NULL): IconElement {
  $label = $entity_type->getLabel();
  $entityTypeId = $entity_type->id();
  return new IconElement($labelOverride ?? $label, NULL, NULL, ['entity.' . $entityTypeId]);
}
