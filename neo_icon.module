<?php

/**
 * @file
 * Primary module hooks for Neo Icon module.
 */

use Drupal\Core\Cache\Cache;
use Drupal\Core\Config\Entity\ConfigEntityInterface;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Link;
use Drupal\Core\Url;
use Drupal\neo_icon\IconElement;

/**
 * Creates a new IconElement object.
 *
 * @param string|null $text
 *   The text to display with the icon.
 * @param string|null $icon
 *   The icon to display.
 * @param string|null $library
 *   The library to use for the icon.
 * @param array $prefix
 *   The prefix to use for the icon.
 *
 * @return \Drupal\neo_icon\IconElement
 *   The IconElement object.
 */
// phpcs:ignore Drupal.NamingConventions.ValidFunctionName.InvalidPrefix
function neo_icon($text = NULL, $icon = NULL, $library = NULL, array $prefix = []): IconElement {
  return new IconElement($text, $icon, $library, $prefix);
}

/**
 * Creates a new IconElement object.
 *
 * @param string|null $text
 *   The text to display with the icon.
 * @param string|null $icon
 *   The icon to display.
 *
 * @return \Drupal\neo_icon\IconElement
 *   The IconElement object.
 */
function neo_icon_admin($text = NULL, $icon = NULL): IconElement {
  return new IconElement($text, $icon, NULL, ['admin']);
}

// The deprecation sniff wants the @see below to be a drupal.org change record.
// This package is not on drupal.org, so the tag names the replacement instead.
// phpcs:disable Drupal.Commenting.Deprecated.DeprecatedWrongSeeUrlFormat

/**
 * Generates an IconElement for a given entity.
 *
 * Determines the appropriate label for the entity, using the bundle label if
 * available, and creates an IconElement instance with the label and entity type
 * information.
 *
 * @param \Drupal\Core\Entity\EntityInterface $entity
 *   The entity for which to generate the icon element.
 * @param string $labelOverride
 *   An optional label override. If provided, this will be used as the label
 *   for the icon element instead of the entity label.
 *
 * @return \Drupal\neo_icon\IconElement
 *   The generated IconElement for the entity.
 *
 * @deprecated in neo_icon:1.2.0 and is removed from neo_icon:2.0.0. Use
 *   \Drupal\neo_icon\IconElementFactory::build() instead.
 *
 * @see \Drupal\neo_icon\IconElementFactory::build()
 */
function neo_icon_entity(EntityInterface $entity, ?string $labelOverride = NULL): IconElement {
  return \Drupal::service('neo_icon.element_factory')->build($entity, $labelOverride);
}

// phpcs:enable Drupal.Commenting.Deprecated.DeprecatedWrongSeeUrlFormat

/**
 * Generates an IconElement for a given entity type.
 *
 * Determines the appropriate label for the entity type and creates an
 * IconElement instance with the label and entity type information.
 *
 * @param \Drupal\Core\Entity\EntityTypeInterface $entity_type
 *   The entity type for which to generate the icon element.
 * @param string $labelOverride
 *   An optional label override. If provided, this will be used as the label
 *   for the icon element instead of the entity type label.
 *
 * @return \Drupal\neo_icon\IconElement
 *   The generated IconElement for the entity type.
 */
function neo_icon_entity_type(EntityTypeInterface $entity_type, ?string $labelOverride = NULL): IconElement {
  $label = $entity_type->getLabel();
  $entityTypeId = $entity_type->id();
  return new IconElement($labelOverride ?? $label, NULL, NULL, ['entity.' . $entityTypeId]);
}

/**
 * Implements hook_form_alter().
 */
function neo_icon_form_alter(&$form, $form_state, $form_id) {
  if ($form_state->getFormObject() instanceof EntityFormInterface) {
    $entity = $form_state->getFormObject()->getEntity();
    if ($entity instanceof ConfigEntityInterface) {
      /** @var \Drupal\neo_icon\IconEntityTypeManager $iconPluginManager */
      $iconPluginManager = \Drupal::service('neo_icon.entity_type.manager');
      if (!$iconPluginManager->isSupportedEntity($entity)) {
        return;
      }
      if (
        strpos($form['#form_id'], '_edit_form') === FALSE &&
        strpos($form['#form_id'], '_add_form') === FALSE &&
        $form['#form_id'] !== $entity->getEntityTypeId() . '_form'
      ) {
        return;
      }
      $form['neo_icon'] = [
        '#type' => 'neo_icon_select',
        '#title' => t('Icon'),
        '#default_value' => $iconPluginManager->getEntityIcon($entity),
        '#parents' => ['neo_icon'],
        '#weight' => 0,
      ];
      $form['#entity_builders'][] = 'neo_icon_form_config_entity_build';
      // Special handling for media types to avoid core error.
      if ($entity->getEntityTypeId() === 'media_type') {
        if (empty($form['source_dependent']['source_configuration'])) {
          unset($form['neo_icon']);
        }
        else {
          $form['source_dependent']['neo_icon'] = $form['neo_icon'];
          unset($form['neo_icon']);
        }
      }
    }
  }
}

/**
 * Entity form builder for config entities that support icons.
 */
function neo_icon_form_config_entity_build($entity_type, ConfigEntityInterface $entity, &$form, FormStateInterface $form_state) {
  /** @var \Drupal\neo_icon\IconEntityTypeManager $iconPluginManager */
  $iconPluginManager = \Drupal::service('neo_icon.entity_type.manager');
  $icon = $form_state->getValue('neo_icon');
  if (!empty($icon) && is_string($icon)) {
    $iconPluginManager->setEntityIcon($entity, $icon);
  }
  else {
    $iconPluginManager->unsetEntityIcon($entity);
  }
  Cache::invalidateTags(['neo_icon']);
}

/**
 * Implements hook_preprocess_table().
 *
 * Preprocess list builder tables.
 */
function neo_icon_preprocess_table(array &$variables) {
  // There is no route object outside a request context, such as when a table is
  // rendered from Drush or a queue worker.
  $route = \Drupal::routeMatch()->getRouteObject();
  if ($route && ($entityTypeId = $route->getDefault('_entity_list'))) {
    /** @var \Drupal\neo_icon\IconEntityTypeManager $iconPluginManager */
    $iconPluginManager = \Drupal::service('neo_icon.entity_type.manager');
    if ($iconPluginManager->isSupportedEntityTypeId($entityTypeId)) {
      foreach ($variables['rows'] as $i => $row) {
        if (!empty($row['cells'])) {
          foreach ([
            'title',
            'name',
          ] as $key) {
            if (isset($row['cells'][$key])) {
              if (isset($row['cells'][$key]['content'])) {
                $variables['rows'][$i]['cells'][$key]['content'] = neo_icon($row['cells'][$key]['content'], NULL, NULL, ['entity.' . $entityTypeId]);
              }
            }
          }
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_node_add_list().
 *
 * Prepares variables for the node add list.
 */
function neo_icon_preprocess_node_add_list(array &$variables) {
  $variables['types'] = [];
  if (!empty($variables['content'])) {
    foreach ($variables['content'] as $type) {
      $variables['types'][$type->id()] = [
        'type' => $type->id(),
        'add_link' => Link::fromTextAndUrl(neo_icon($type->label(), NULL, NULL, ['entity.node']), Url::fromRoute('node.add', ['node_type' => $type->id()]))->toString(),
        'description' => [
          '#markup' => $type->getDescription(),
        ],
      ];
    }
  }
}

/**
 * Implements hook_preprocess_entity_add_list().
 *
 * Prepares variables for the entity add list.
 */
function neo_icon_preprocess_entity_add_list(array &$variables) {
  if (!empty($variables['bundles'])) {
    $routeMatch = \Drupal::routeMatch();
    $entityTypeId = $routeMatch->getParameter('entity_type_id');
    if (!$entityTypeId) {
      foreach ($variables['bundles'] as $data) {
        /** @var \Drupal\Core\Link $link */
        $link = $data['add_link'];
        $params = $link->getUrl()->getRouteParameters();
        if ($params) {
          $entityTypeId = array_key_last($params);
        }
      }
    }
    if ($entityTypeId) {
      foreach ($variables['bundles'] as $data) {
        /** @var \Drupal\Core\Link $link */
        $link = $data['add_link'];
        $link->setText(neo_icon($data['label'], NULL, NULL, ['entity.' . $entityTypeId]));
      }
    }
  }
}

/**
 * Implements hook_preprocess_accordion_item().
 */
function neo_icon_preprocess_accordion_item(array &$variables) {
  if (!empty($variables['element']['#icon'])) {
    $variables['title'] = neo_icon($variables['title'], $variables['element']['#icon']);
  }
}
